# java.util.logging configuration for Scilab.
#
# This file is loaded once at JVM startup through
# -Djava.util.logging.config.file (set in etc/jvm_options.xml).
# Any change requires a Scilab restart to take effect.
#
# This variant is used for Visual Studio builds (levels are hardcoded).
#
# To enable console output, uncomment the handlers line below. On Windows
# desktop, the console handler writes to the hidden OS terminal; use
# consolebox("on") (or press F12) in Scilab to reveal it.
# handlers = java.util.logging.ConsoleHandler

# FOP logging level
org.apache.fop.level = SEVERE
org.apache.fop.render.level = SEVERE

org.scilab.level = INFO
# Release level
# org.scilab.level = SEVERE

# Xcos logging level
org.scilab.modules.xcos.level = INFO
# Release level
# org.scilab.level = SEVERE

# Console logging level
org.scilab.modules.core.level = INFO
org.scilab.modules.console.level = INFO
org.scilab.modules.gui.level = INFO
org.scilab.modules.commons.gui.level = INFO
