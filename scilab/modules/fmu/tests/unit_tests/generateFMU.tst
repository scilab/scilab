// <-- NO CHECK REF -->
// unit test for the FMU archive generated by do_compile_fmu
// the generated .fmu must be a valid zip archive loadable by loadFMU

loadXcosLibs();
path = fmigetPath();
assert_checktrue(importXcosDiagram(fullfile(path, "tests", "unit_tests", "helpPageSuper.zcos")));
blk = scs_m.objs(1); // only one block is on the diagram

// x_mdialog overload (no UI interaction)
function str = x_mdialog(desc, labels, ini)
    ini(1) = "generateFMU";
    ini(2) = TMPDIR + "/generateFMU/";
    str = ini;
endfunction

// mprintf overload (quiet test)
function mprintf(varargin)
endfunction

// generate an FMU for ME
assert_checktrue(do_compile_fmu());

fmuFile = fullfile(TMPDIR, "generateFMU", "generateFMU.fmu");
assert_checktrue(isfile(fmuFile));

// check the zip signature
fd = mopen(fmuFile, "rb");
assert_checkequal(mget(4, "uc", fd), [80 75 3 4]);
mclose(fd);

// check the FMU structure
outdir = fullfile(TMPDIR, "generateFMU", "unzipped");
mkdir(outdir);
decompress(fmuFile, outdir);
assert_checktrue(isfile(fullfile(outdir, "modelDescription.xml")));
assert_checktrue(isfile(fullfile(outdir, "sources", "generateFMU_Scilab_FMU.c")));
assert_checktrue(isfile(fullfile(outdir, "sources", "fmiModelFunctions.h")));
assert_checktrue(isfile(fullfile(outdir, "sources", "fmiModelTypes.h")));
if getos() == "Windows" then
    so = ".dll";
else
    so = ".so";
end
[sys, vers] = getversion();
if getos() == "Windows" then
    if win64() then
        arch = "win64";
    else
        arch = "win32";
    end
elseif vers(2) == "x64" then
    arch = "linux64";
else
    arch = "linux32";
end
assert_checktrue(isfile(fullfile(outdir, "binaries", arch, "generateFMU" + so)));

// load the generated FMU
[workdir, xml, libname, modelIdentifier, fmuImpl] = loadFMU(fmuFile);
assert_checktrue(isdir(workdir));
assert_checktrue(typeof(xml) == "XMLDoc");
assert_checkequal(modelIdentifier, "generateFMU");
assert_checkequal(fmuImpl, "me 1.0");

mdelete(TMPDIR + "/generateFMU/");
