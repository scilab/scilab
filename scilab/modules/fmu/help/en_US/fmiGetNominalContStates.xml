                <link linkend="fmiGetContinuousStates">fmiGetContinuousStates</link>
            </member>
            <member>
                <link linkend="fmiGetStateValueRefs">fmiGetStateValueRefs</link>
            </member>
        </simplelist>
  </refsection> 
</refentry>