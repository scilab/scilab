        <title>See Also</title>
        <simplelist type="inline">
            <member>
                <link linkend="fmiSetReal">fmiSetReal</link>
            </member>
			<member>
                <link linkend="fmiSetInteger">fmiSetInteger</link>
            </member>
            <member>
                <link linkend="fmiSetBoolean">fmiSetBoolean</link>
            </member>
        </simplelist>
  </refsection> 
</refentry>