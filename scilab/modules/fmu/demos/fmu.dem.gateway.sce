function subdemolist = demo_gateway()

  demopath = get_absolute_file_path("fmu.dem.gateway.sce");
  _("Functional Mock-up Interface (FMU)");  // lets gettext() harvesting it
  if with_module("xcos") then
      add_demo("Functional Mock-up Interface (FMU)", demopath + "fmu.dem.gateway.sce");
  end

  subdemolist = ["FMU v1 CoSim Cruise Control", "CruiseControl.sce"
                 // "FMU v1 CoSim PID controller FMU Generated by Xcos", "XcosPIDcontroller.sce"
                 // "FMU v1 CoSim with Python ", "TestPythonCoSimulation.sce"
                 "FMU v2 Cosim/ModelExchange Bouncing Ball", "BouncingBall.sce"
                 "FMU v2 Cosim/ModelExchange Dahlquist", "Dahlquist.sce"
                 "FMU v2 Cosim/ModelExchange Feedthrough", "Feedthrough.sce"
                 "FMU v2 Cosim/ModelExchange Resource", "Resource.sce"
                 "FMU v2 Cosim/ModelExchange Stair", "Stair.sce"
                 "FMU v2 Cosim/ModelExchange VanDerPol", "VanDerPol.sce"
                 ]; // add demos here
  subdemolist(:,2) = demopath + subdemolist(:,2);

endfunction

subdemolist = demo_gateway();
clear demo_gateway; // remove demo_gateway on stack
