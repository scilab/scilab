function demo_compute()

    
    path = fmigetPath();
    f = fullfile(path, "demos", "TestPythonCoSimulation.fmu");
    model = importFMU(f);
    inst = fmiInstantiateSlave(model, 5, %f);
    
    tStart = strtod(get("start", "string"));
    tStop = strtod(get("stop", "string"));
    ts = strtod(get("step", "string"))

    realVar = model.modelVariables.Real;

    idxX = find(realVar.name == "mass1.x");
    refX = realVar.valueReference(idxX);

    idxV = find(realVar.name == "mass1.v");
    refV = realVar.valueReference(idxV);

    m = strtod(get("m", "string"));
    idxM = find(realVar.name == "mass1.m");
    refM = realVar.valueReference(idxM);
    fmiSetReal(inst, refM, m);

    k = strtod(get("k", "string"));
    idxK = find(realVar.name == "springDamper1.k");
    refK = realVar.valueReference(idxK);
    fmiSetReal(inst, refK, k);

    time=tStart:ts:tStop;
    xvalues = zeros(size(time));
    vvalues = zeros(size(time));

    idx=1;

    inst = fmiInitializeSlave(inst, tStart, tStop);
    tic();
    while idx<=size(time,2)
        tc=time(idx);
        
        //mass1.x
        xvalues(idx) = fmiGetReal(inst, refX);
        //mass1.v
        vvalues(idx) = fmiGetReal(inst, refV);
       
        fmiDoStep(inst, tc, ts, %t);
       
        idx = idx + 1;
    end
    t = toc();
    fmiTerminateSlave(inst);
    fmiFreeSlaveInstance(inst);

    axe = get("axe");
    delete(axe);
    axe = newaxes(get("center"));
    axe.tag = "axe";

    plot(time, xvalues, time, vvalues);
endfunction  
