// AI agents the SciNotes assistant talks to through the Agent Client
// Protocol (ACP, https://agentclientprotocol.com).
//
// Scilab installs nothing: each agent is a program the user installed.
// This file only says how to find and start it. Defaults shipped with
// Scilab: do not edit this file to change your own setup, write only what
// differs in SCIHOME/assistant/agents.json (same format, a key there
// replaces the one here, a new id adds a custom agent), or use the
// "Command line" section of the assistant settings page.
//
// Per agent:
//   "name"     display name
//   "command"  program names searched in "dirs" then on the PATH, first
//              found wins (".exe"/".cmd" are tried on Windows)
//   "args"     arguments that start the program in ACP mode
//   "dirs"     extra directories searched before the PATH (%VAR% and ~ are
//              expanded); the user can also set the full path in the
//              settings page
//   "env"      environment variables set for the program
//
// How to install and sign in to each agent: help page "scinotes_assistant"
// (SCI/modules/scinotes/help/en_US/scinotes_assistant.xml).
{
    "claude": {
        "name": "Claude",
        "command": ["claude-agent-acp"],
        "args": []
    },
    "codex": {
        "name": "OpenAI Codex",
        "command": ["codex-acp"],
        "args": []
    },
    "copilot": {
        "name": "GitHub Copilot",
        "command": ["copilot"],
        "args": ["--acp"]
    },
    "cursor": {
        "name": "Cursor",
        "command": ["cursor-agent", "agent"],
        "args": ["acp"],
        "dirs": ["%LOCALAPPDATA%\\cursor-agent", "~/.local/bin"]
    },
    "gemini": {
        "name": "Google Gemini CLI",
        "command": ["gemini"],
        "args": ["--acp"]
    },
    "antigravity": {
        "name": "Google Antigravity",
        "command": ["agy_acp_server", "agy_acp_server.par"],
        "args": []
    },
    "vibe": {
        "name": "Mistral Vibe",
        "command": ["vibe-acp"],
        "args": [],
        "dirs": ["~/.local/bin"]
    }
}
