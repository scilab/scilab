// <-- Short Description -->
// 'tbx_build_help' function did not manage languages correctly.
SRC = SCI + '/contrib/toolbox_skeleton';
DST = TMPDIR + '/toolbox_skeleton';
mkdir(DST);
assert_checkequal(isdir(DST), %T);
copyfile(SRC, DST);
cd(DST);
ilib_verbose(0);
exec('builder.sce');
