<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Scilab desktop launcher manifest fragment (merged by mt.exe into the
  linker-generated manifest).

  dpiAware=false declares the process explicitly DPI unaware and locks it: it can no longer be changed at runtime by JCEF.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">false</dpiAware>
    </windowsSettings>
  </application>
</assembly>
