// <-- TEST WITH GRAPHIC -->
// <-- Non-regression test for bug 3454 -->
//
// <-- GitLab URL -->
// https://gitlab.com/scilab/scilab/-/issues/3454
//
// <-- Short Description -->
// figure.axes_size and figure.figure_size might not be updated immediately.
//
// helper to execute a Scilab command after all pending AWT events have been processed
jimport org.scilab.modules.action_binding.highlevel.ScilabInterpreterManagement
// Test 1 : axes_size, auto_resize = "on"
// ===========================
// Create a default figure
my_figure = scf();
clf(my_figure,"reset");
// Get default values
my_default_figure_size = my_figure.figure_size;
my_default_axes_size   = my_figure.axes_size;
// auto_resize = "on"
my_figure.auto_resize = "on";
ScilabInterpreterManagement.executeAndWaitForEDT("my_figure.axes_size = my_default_axes_size + 10;");
assert_checkequal(my_figure.axes_size, my_default_axes_size + 10);
assert_checkequal(my_figure.figure_size, my_default_figure_size + 10);
// Delete
delete(my_figure);
// Test 2 : axes_size, auto_resize = "off"
// ============================
// Create a default figure
my_figure = scf();
clf(my_figure,"reset");
// Get default values
my_default_figure_size = my_figure.figure_size;
my_default_axes_size   = my_figure.axes_size;
// auto_resize = "on"
my_figure.auto_resize = "off";
ScilabInterpreterManagement.executeAndWaitForEDT("my_figure.axes_size = my_default_axes_size + 10;");
assert_checkequal(my_figure.axes_size, my_default_axes_size + 10);
assert_checkequal(my_figure.figure_size, my_default_figure_size);
// Delete
delete(my_figure);
// Test 3 : figure_size, auto_resize = "on"
// ===========================
// Create a default figure
my_figure = scf();
clf(my_figure,"reset");
// Get default values
my_default_figure_size = my_figure.figure_size;
my_default_axes_size   = my_figure.axes_size;
// auto_resize = "on"
my_figure.auto_resize = "on";
ScilabInterpreterManagement.executeAndWaitForEDT("my_figure.figure_size = my_default_figure_size + 10;");
assert_checkequal(my_figure.figure_size, my_default_figure_size + 10);
assert_checkequal(my_figure.axes_size, my_default_axes_size + 10);
// Delete
delete(my_figure);
// Test 4 : figure_size, auto_resize = "off"
// ============================
// Create a default figure
my_figure = scf();
clf(my_figure,"reset");
// Get default values
my_default_figure_size = my_figure.figure_size;
my_default_axes_size   = my_figure.axes_size;
// auto_resize = "on"
my_figure.auto_resize = "off";
ScilabInterpreterManagement.executeAndWaitForEDT("my_figure.figure_size = my_default_figure_size + 10;");
assert_checkequal(my_figure.figure_size, my_default_figure_size + 10);
assert_checkequal(my_figure.axes_size, my_default_axes_size);
// Delete
delete(my_figure);
