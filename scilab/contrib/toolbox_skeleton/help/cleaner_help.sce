function cleaner_help()
    path = get_absolute_file_path();
    d = dir(path);
    langdirs = d.name(d.isdir);
    langdirs = langdirs(grep(langdirs, "/^[a-z]{2}_[A-Z]{2}$/", "r"));

    for l = 1:size(langdirs, "*")
        masterfile = fullpath(path + filesep() + langdirs(l) + "/master_help.xml");
        mdelete(masterfile);

        // leftovers of the builds predating the JCEF help browser
        jarfile = fullpath(path + "/../jar/scilab_" + langdirs(l) + "_help.jar");
        mdelete(jarfile);

        tmphtmldir = fullpath(path + "/" + langdirs(l) + "/scilab_" + langdirs(l) + "_help");
        rmdir(tmphtmldir, "s");
    end

    // images pre-generated by tbx_build_help(): only the ones the manifest
    // owns, help/images also holds the images shipped with the toolbox
    imagedir = fullpath(path + "/images");
    index = imagedir + filesep() + "help_images.index";
    if isfile(index) then
        lines = mgetl(index);
        for i = 1:size(lines, "*")
            tok = tokens(lines(i));
            if size(tok, "*") == 2 then
                mdelete(imagedir + filesep() + tok(2));
            end
        end
        mdelete(index);
    end
endfunction

cleaner_help();
clear cleaner_help;
